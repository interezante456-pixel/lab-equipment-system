generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum StudentStatus {
  ACTIVE
  PENALIZED
}

enum EquipmentCategory {
  COMPUTO
  ELECTRONICA
  REDES
}

enum EquipmentStatus {
  DISPONIBLE
  RESERVADO
  PRESTADO
  MANTENIMIENTO
  INACTIVO
}

enum ReservationStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
  PRESTADA
  DEVUELTO_A_TIEMPO
  DEVUELTO_CON_RETRASO
  CANCELADA
}

model User {
  id             String        @id @default(uuid())
  studentCode    String        @unique
  email          String        @unique
  fullName       String
  career         String?
  passwordHash   String
  role           Role          @default(STUDENT)
  studentStatus  StudentStatus @default(ACTIVE)
  failedAttempts Int           @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  reservations  Reservation[]
  penalties     Penalty[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([studentCode])
  @@map("users")
}

model Equipment {
  id             String            @id @default(uuid())
  inventoryCode  String            @unique
  name           String
  category       EquipmentCategory
  brand          String
  model          String
  serialNumber   String?           @unique
  location       String
  status         EquipmentStatus   @default(DISPONIBLE)
  imageUrl       String?
  specifications String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  reservations Reservation[]

  @@index([category, status])
  @@map("equipments")
}

model Reservation {
  id               String            @id @default(uuid())
  userId           String
  equipmentId      String
  startTime        DateTime
  endTime          DateTime
  actualReturnTime DateTime?
  status           ReservationStatus @default(PENDIENTE)
  rejectionReason  String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])
  penalty   Penalty?

  @@index([equipmentId, startTime, endTime])
  @@index([userId, status])
  @@map("reservations")
}

model Penalty {
  id            String    @id @default(uuid())
  userId        String
  reservationId String    @unique
  reason        String
  startDate     DateTime  @default(now())
  endDate       DateTime
  isActive      Boolean   @default(true)
  liftedReason  String?
  liftedBy      String?
  createdAt     DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("penalties")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
